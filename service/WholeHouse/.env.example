# Django 签名密钥：请使用随机长字符串替换，禁止提交真实密钥
DJANGO_SECRET_KEY=请替换为随机且保密的字符串
# 本地开发填写 True，公开环境填写 False
DJANGO_DEBUG=True
# 多个主机使用英文逗号分隔，不包含协议和端口
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 以下配置必须与实际 MySQL 数据库和账号一致
DB_NAME=whole_house_customization
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_HOST=127.0.0.1
DB_PORT=3306
